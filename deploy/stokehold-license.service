[Unit]
Description=Stokehold licence server and admin interface
After=network-online.target
Wants=network-online.target

[Service]
User=stokehold-license
Group=stokehold-license
ExecStart=/usr/local/bin/stokehold-license serve -db /var/lib/stokehold-license/licenses.db -online /etc/stokehold-license/online.json -listen 127.0.0.1:8090 -admin-listen 127.0.0.1:8091 -trust-proxy
StateDirectory=stokehold-license
ConfigurationDirectory=stokehold-license
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=96M
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
