[Unit]
Description=Stokehold Discord interactions bot
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/stokehold/bot.env
ExecStart=/usr/local/bin/stokehold-bot
DynamicUser=yes
StateDirectory=stokehold-bot
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=64M
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
